---
import { supabase } from "../lib/supabase";

const user = Astro.locals.user;

const { data: books, error } = await supabase
    .from("books")
    .select("*")
    .eq("user_id", user?.id)
    .order("created_at", { ascending: false });

if (error) {
    console.error("Error cargando libros:", error.message);
}
---

<div class="flex flex-col lg:flex-row gap-4 relative items-start">
    
    {books && books.length > 1 && (
    <aside class="w-full lg:w-56 shrink-0 lg:sticky lg:top-28 order-1 lg:order-2">
        <div class="bg-white/10 backdrop-blur-xl border border-white/20 shadow-[0_8px_32px_rgba(0,0,0,0.3)] rounded-2xl p-4 text-white transition-all duration-300" id="filters-container">
            <button id="filters-header" class="w-full text-left text-sm font-serif font-bold flex items-center justify-between lg:justify-start gap-2 lg:mb-3 cursor-pointer">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    Filters
                </div>
                <svg id="filters-chevron" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/60 lg:hidden transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>

            <div id="filters-content" class="hidden lg:block space-y-6 mt-4 lg:mt-0">
                <div class="space-y-2">
                    <label class="text-[10px] uppercase tracking-widest text-white/40 font-bold ml-1">Status</label>
                    <div class="flex flex-col gap-1.5">
                        <label class="group relative flex items-center gap-2.5 p-2.5 rounded-lg bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all duration-300 has-[:checked]:bg-blue-600/20 has-[:checked]:border-blue-500/50">
                            <input type="radio" name="status" value="all" checked class="peer sr-only" />
                            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/20 peer-checked:border-blue-400 peer-checked:bg-blue-400 transition-all"></div>
                            <span class="text-xs font-medium text-white/80 peer-checked:text-white">All Books</span>
                        </label>
                        
                        <label class="group relative flex items-center gap-2.5 p-2.5 rounded-lg bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all duration-300 has-[:checked]:bg-blue-600/20 has-[:checked]:border-blue-500/50">
                            <input type="radio" name="status" value="reading" class="peer sr-only" />
                            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/20 peer-checked:border-blue-400 peer-checked:bg-blue-400 transition-all"></div>
                            <span class="text-xs font-medium text-white/80 peer-checked:text-white">Reading</span>
                        </label>

                        <label class="group relative flex items-center gap-2.5 p-2.5 rounded-lg bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all duration-300 has-[:checked]:bg-blue-600/20 has-[:checked]:border-blue-500/50">
                            <input type="radio" name="status" value="completed" class="peer sr-only" />
                            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/20 peer-checked:border-blue-400 peer-checked:bg-blue-400 transition-all"></div>
                            <span class="text-xs font-medium text-white/80 peer-checked:text-white">Completed</span>
                        </label>

                        <label class="group relative flex items-center gap-2.5 p-2.5 rounded-lg bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all duration-300 has-[:checked]:bg-blue-600/20 has-[:checked]:border-blue-500/50">
                            <input type="radio" name="status" value="plan to read" class="peer sr-only" />
                            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/20 peer-checked:border-blue-400 peer-checked:bg-blue-400 transition-all"></div>
                            <span class="text-xs font-medium text-white/80 peer-checked:text-white">Plan to Read</span>
                        </label>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] uppercase tracking-widest text-white/40 font-bold ml-1">Sort by created Date</label>
                    <div class="flex bg-white/5 p-1 rounded-lg border border-white/10">
                        <label class="flex-1 text-center cursor-pointer">
                            <input type="radio" name="sort" value="newest" checked class="peer sr-only" />
                            <span class="block py-1.5 px-2 rounded-md text-[10px] font-bold text-white/60 transition-all peer-checked:bg-white/20 peer-checked:text-white peer-checked:shadow-sm">Newest</span>
                        </label>
                        <label class="flex-1 text-center cursor-pointer">
                            <input type="radio" name="sort" value="oldest" class="peer sr-only" />
                            <span class="block py-1.5 px-2 rounded-md text-[10px] font-bold text-white/60 transition-all peer-checked:bg-white/20 peer-checked:text-white peer-checked:shadow-sm">Oldest</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </aside>
    )}

    <div id="books-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10 flex-1 order-2 lg:order-1 w-full">

    {
        books?.map((book) => {
            const { id, title, author, cover_url, status, created_at } = book;

            return (
                <article 
                    class="book-item flex flex-col items-start w-full group"
                    data-status={status}
                    data-created={new Date(created_at).getTime()}
                >
                    <a
                        href={`/books/${id}`}
                        class="block w-full transition-transform duration-300 hover:scale-105"
                    >
                        <img
                            transition:name={`img-${id}`}
                            src={cover_url || "/placeholder-book.jpg"}
                            alt={title}
                            class="w-full aspect-2/3 object-cover rounded-lg shadow-lg border border-white/10"
                        />

                        <div class="flex flex-col gap-2 mt-3 w-full">
                            <h3 class="text-lg font-serif leading-tight text-white line-clamp-2 wrap-break-word min-h-2">
                                {title}
                            </h3>
                            <p class="text-sm text-gray-400 truncate w-full">{author}</p>
                            <span class="inline-block w-fit text-[10px] bg-white/10 px-2 py-1 rounded text-gray-400 uppercase tracking-wider">
                                {status}
                            </span>
                        </div>
                    </a>
                </article>
            );
        })
    }

    {
        books?.length === 0 && (
            <div class="col-span-full text-center py-20 border-2 border-dashed border-white/10 rounded-3xl w-full">
                <p class="text-gray-500">
                    No books in the shelf yet. Start by uploading one!
                </p>
                <a
                    href="/upload"
                    class="text-blue-400 hover:underline mt-2 inline-block"
                >
                    Add book
                </a>
            </div>
        )
    }
    </div>
</div>

<script>
    function initBookshelf() {
        const grid = document.getElementById('books-grid');
        if (!grid) return;

        const statusInputs = document.querySelectorAll('input[name="status"]');
        const sortInputs = document.querySelectorAll('input[name="sort"]');
        
        function filterAndSortBooks() {
            let books = Array.from(document.querySelectorAll('.book-item')) as HTMLElement[];
            const statusChecked = document.querySelector('input[name="status"]:checked') as HTMLInputElement;
            const sortChecked = document.querySelector('input[name="sort"]:checked') as HTMLInputElement;

            if (!statusChecked || !sortChecked) return;

            const selectedStatus = statusChecked.value;
            const selectedSort = sortChecked.value;

            const positions = new Map();
            books.forEach(book => {
                if (book.style.display !== 'none') {
                    const rect = book.getBoundingClientRect();
                    positions.set(book, { top: rect.top, left: rect.left });
                }
            });

            books.forEach(book => {
                const bookStatus = book.dataset.status;
                const shouldShow = selectedStatus === 'all' || bookStatus === selectedStatus;
                book.style.display = shouldShow ? 'flex' : 'none';
            });

            const visibleBooks = books.filter(book => book.style.display !== 'none');
            
            visibleBooks.sort((a, b) => {
                const dateA = parseInt(a.dataset.created || '0');
                const dateB = parseInt(b.dataset.created || '0');
                return selectedSort === 'newest' ? dateB - dateA : dateA - dateB;
            });

            visibleBooks.forEach(book => grid?.appendChild(book));

            visibleBooks.forEach(book => {
                const oldPos = positions.get(book);
                if (oldPos) {
                    const newRect = book.getBoundingClientRect();
                    const deltaX = oldPos.left - newRect.left;
                    const deltaY = oldPos.top - newRect.top;

                    if (deltaX !== 0 || deltaY !== 0) {
                        book.animate([
                            { transform: `translate(${deltaX}px, ${deltaY}px)` },
                            { transform: 'none' }
                        ], {
                            duration: 500,
                            easing: 'cubic-bezier(0.4, 0, 0.2, 1)'
                        });
                    }
                }
            });
        }

        statusInputs.forEach(input => input.addEventListener('change', filterAndSortBooks));
        sortInputs.forEach(input => input.addEventListener('change', filterAndSortBooks));

        const filtersHeader = document.getElementById('filters-header');
        const filtersContent = document.getElementById('filters-content');
        const filtersChevron = document.getElementById('filters-chevron');

        if (filtersHeader && filtersContent && filtersChevron) {
            filtersHeader.addEventListener('click', () => {
                if (window.innerWidth < 1024) {
                    filtersContent.classList.toggle('hidden');
                    filtersChevron.classList.toggle('rotate-180');
                }
            });
        }
    }

    document.addEventListener('astro:page-load', initBookshelf);
</script>