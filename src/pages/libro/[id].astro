---
export const prerender = false;

import LayoutApp from "../../layouts/LayoutApp.astro";
import { supabase } from "../../lib/supabase";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/dashboard");
}

const { data: book, error } = await supabase
  .from("books")
  .select("*")
  .eq("id", id)
  .single();

if (error || !book) {
  return Astro.redirect("/404");
}

const { title, author, cover_url, pages, review, status } = book;

console.log(`Datos del libro: title: ${title}, author: ${author}`);
---

<LayoutApp title={`${title} | CometReads`}>
  <div class="flex flex-col md:flex-row gap-12 m-20">
    <aside class="w-full md:w-1/3 flex flex-col gap-4">
      <img
        transition:name={`img-${id}`}
        src={cover_url}
        alt={title}
        class="rounded-2xl
         w-64 object-cover aspect-2/3
         shadow-[0_0_40px_rgba(255,255,255,0.18)]
         border border-white/10"
      />
      <div class="flex justify-between items-center px-2">
        <span class="text-sm text-gray-400">{pages} pages</span>
        <span
          class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-tighter ${
            status === "reading"
              ? "bg-blue-500/20 text-blue-400"
              : "bg-green-500/20 text-green-400"
          }`}
        >
          {status}
        </span>
      </div>
    </aside>

    <main class="flex-1 flex flex-col justify-start">
      <div class="block">
        <h1
          class="font-serif text-5xl md:text-7xl font-bold text-white mb-4 leading-tight break-words"
        >
          {title}
        </h1>

        <p class="text-2xl md:text-3xl text-white/70 italic font-light">
          por {author}
        </p>
      </div>

      <div class="mt-12 pt-8 border-t border-white/10">
        <h2
          class="text-xs uppercase tracking-[0.3em] text-white/30 font-bold mb-6"
        >
          Reseña del lector
        </h2>
        <div class="prose prose-invert prose-lg max-w-none">
          <p
            class="text-white/90 leading-relaxed font-light italic border-l-4 border-white/10 pl-6"
          >
            {review || "Sin reseña disponible."}
          </p>
        </div>
      </div>
    </main>
  </div>
</LayoutApp>
