---
export const prerender = false;

import LayoutApp from "../../layouts/LayoutApp.astro";
import { supabase } from "../../lib/supabase";

// 1. Obtenemos el ID de los parámetros de la URL
const { id } = Astro.params;

// 2. Si no hay ID, redirigimos (opcional)
if (!id) {
  return Astro.redirect("/dashboard");
}

// 3. Consultamos el libro específico en Supabase
const { data: book, error } = await supabase
  .from("books")
  .select("*")
  .eq("id", id)
  .single(); // .single() porque solo esperamos un resultado

// 4. Si el libro no existe o hay error, manejamos el 404
if (error || !book) {
  return Astro.redirect("/404");
}

const { title, author, cover_url, pages, review, status } = book;
---

<LayoutApp title={`${title} | My Bookshelf`}>
  <div class="flex flex-col md:flex-row gap-12 mt-8">
    
    <aside class="w-full md:w-1/3 flex flex-col gap-4">
      <img 
        transition:name={`img-${id}`}
        src={cover_url} 
        alt={title} 
        class="rounded-2xl shadow-2xl w-full object-cover aspect-[2/3] border border-white/10"
      />
      <div class="flex justify-between items-center px-2">
        <span class="text-sm text-gray-400">{pages} páginas</span>
        <span class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-tighter ${
          status === 'reading' ? 'bg-blue-500/20 text-blue-400' : 'bg-green-500/20 text-green-400'
        }`}>
          {status}
        </span>
      </div>
    </aside>

    <main class="flex-1">
      <h1 
        transition:name={`title-${id}`}
        class="text-5xl font-black mb-4"
      >
        {title}
      </h1>
      <p class="text-2xl text-white/60 mb-8 italic">{author}</p>
      
      <div class="prose prose-invert max-w-none">
        <h2 class="text-xl font-bold mb-4 text-white/80">Mi reseña</h2>
        <p class="text-gray-300 leading-relaxed text-lg">
          {review || "Aún no has escrito una review para este libro."}
        </p>
      </div>
    </main>

  </div>
</LayoutApp>