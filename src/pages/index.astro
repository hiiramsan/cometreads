---
import LayoutPublic from "../layouts/LayoutPublic.astro";
export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  return Astro.redirect("/books");
}
---

<LayoutPublic title="CometReads">
	<div
		class="min-h-screen w-full relative flex flex-col items-center gap-6 pt-16"
	>
		<img src="logo.png" alt="logo" class="w-42 h-auto" />
		<p class="text-white font-serif text-5xl pt-12">
			A pleasant space to track your <span
				class="underline decoration-blue-500 underline-offset-4 decoration-2 decoration-wavy"
				>reading</span
			>
		</p>
		<p class="text-white text-xl font-thin">
			What you're reading. What you've finished. What you want to read
		</p>
		<a
			href="/login"
			class="group relative isolate flex items-center justify-center gap-2 mx-auto
         overflow-hidden rounded-full border-2 border-gray-200
         bg-gray-50 px-4 py-2 text-lg font-semibold shadow-xl
         transition-colors duration-300 hover:text-white"
		>
			<span
				class="absolute inset-0 -z-10 translate-x-[-100%]
           bg-blue-600 transition-transform duration-700
           group-hover:translate-x-0"
			></span>

			Get started

			<svg
				class="w-8 h-8 rotate-45 rounded-full border border-gray-700
           p-2 transition-all duration-300
           group-hover:rotate-90 group-hover:bg-white group-hover:border-none"
				viewBox="0 0 16 19"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M7 18C7 18.5523 7.44772 19 8 19C8.55228 19 9 18.5523 9 18H7ZM8.70711 0.292893C8.31658 -0.0976311 7.68342 -0.0976311 7.29289 0.292893L0.928932 6.65685C0.538408 7.04738 0.538408 7.68054 0.928932 8.07107C1.31946 8.46159 1.95262 8.46159 2.34315 8.07107L8 2.41421L13.6569 8.07107C14.0474 8.46159 14.6805 8.46159 15.0711 8.07107C15.4616 7.68054 15.4616 7.04738 15.0711 6.65685L8.70711 0.292893ZM9 18L9 1H7L7 18H9Z"
					class="fill-gray-800"></path>
			</svg>
		</a>

		<script
			src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.11/dist/dotlottie-wc.js"
			type="module"></script>;
		<dotlottie-wc
			src="https://lottie.host/36bb1cf3-f50d-4041-bb1b-0114dd6e1919/Oa45AHNvlF.lottie"
			style="width: 220px;height: 220px"
			autoplay
			loop></dotlottie-wc>
		<div class="text-white fixed bottom-10">
			Built by <a href="https:hiramsanchez.vercel.app" target="_blank" class="underline">@hiiramsan</a> with hate
		</div>
	</div>
</LayoutPublic>
