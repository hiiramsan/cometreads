---
export const prerender = false;

import LayoutApp from "../layouts/LayoutApp.astro";
import { supabase } from "../lib/supabase";

const accessToken = Astro.cookies.get("sb-access-token");
if (!accessToken) return Astro.redirect("/login");

const { data: books, error } = await supabase
  .from("books")
  .select("*")
  .neq("status", "plan to read")
  .order("start_date", { ascending: false });

if (error) console.error(error);

const formatDate = (dateString: string) => {
    if (!dateString) return "No date";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
};
---

<LayoutApp title="Timeline | CometReads">
  <div class="max-w-4xl mx-auto px-6 py-20">
    <header class="mb-16">
      <h1 class="text-white text-5xl font-serif font-bold mb-4">Timeline</h1>
      <p class="text-white/40 text-lg italic">The trail of your read stories.</p>
    </header>

    <div class="relative border-l border-white/10 ml-4 md:ml-8 space-y-16">
      {
        books?.map((book) => (
          <div class="relative pl-10">
            <div class={`absolute -left-[9px] top-2 w-4 h-4 rounded-full border-2 border-black ${book.status === 'completed' ? 'bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]' : 'bg-blue-500 animate-pulse shadow-[0_0_10px_rgba(59,130,246,0.5)]'}`}></div>
            
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <div class="min-w-[140px] pt-1 flex flex-col gap-4">
                {book.status === 'completed' ? (
                  <>
                    <div>
                      <span class="text-xs uppercase tracking-[0.2em] text-white/30 font-bold block mb-1">
                        Completed
                      </span>
                      <span class="text-white/60 font-serif italic text-sm">
                        {formatDate(book.end_date)}
                      </span>
                    </div>
                    <div>
                      <span class="text-xs uppercase tracking-[0.2em] text-white/30 font-bold block mb-1">
                        Started
                      </span>
                      <span class="text-white/60 font-serif italic text-sm">
                        {formatDate(book.start_date)}
                      </span>
                    </div>
                  </>
                ) : (
                  <div>
                    <span class="text-xs uppercase tracking-[0.2em] text-white/30 font-bold block mb-1">
                      Started
                    </span>
                    <span class="text-white/60 font-serif italic text-sm">
                      {formatDate(book.start_date)}
                    </span>
                  </div>
                )}
              </div>

              <a href={`/books/${book.id}`} class="group flex-1 bg-white/5 border border-white/10 p-6 rounded-2xl hover:bg-white/[0.08] transition-all duration-300">
                <div class="flex gap-6">
                  <img 
                    transition:name={`img-${book.id}`}
                    src={book.cover_url || "/placeholder-book.svg"} 
                    alt={book.title} 
                    class="w-20 h-28 object-cover rounded-lg shadow-lg group-hover:scale-105 transition-transform"
                    onerror="this.src='/placeholder-book.svg'"
                  />
                  <div>
                    <h3 class="text-xl font-bold text-white mb-1 group-hover:text-blue-400 transition-colors">
                      {book.title}
                    </h3>
                    <p class="text-white/40 text-sm mb-4 italic">{book.author}</p>
                    
                    {book.review && (
                      <p class="text-gray-400 text-sm line-clamp-2 italic font-light">
                        "{book.review}"
                      </p>
                    )}
                    
                    <div class="mt-4">
                      <span class={`text-[10px] uppercase tracking-widest px-2 py-1 rounded border ${book.status === 'completed' ? 'border-green-500/30 text-green-400' : 'border-blue-500/30 text-blue-400'}`}>
                        {book.status === 'completed' ? 'Completed' : 'Reading'}
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          </div>
        ))
      }

      {books?.length === 0 && (
        <div class="pl-10 text-white/20 italic">
          You haven't started reading any books yet. Go to your library and mark one as "Reading"!
        </div>
      )}
    </div>
  </div>
</LayoutApp>