---
import Layout from "../layouts/LayoutApp.astro";
---

<Layout title="Add book | CometReads">
  <section class="max-w-2xl mx-auto mt-6 px-4">
    <h1 class="text-3xl font-bold text-white mb-8 text-center">Add to my bookshelf</h1>
    
    <form action="/api/books" method="POST" class="grid grid-cols-1 gap-6 bg-white/5 p-8 rounded-3xl border border-white/10 backdrop-blur-md shadow-2xl">
      
      <div class="flex flex-col gap-2">
        <label class="text-white/60 text-sm ml-1">Book title</label>
        <input name="title" type="text" required class="bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" placeholder="Ej: Rayuela" />
      </div>

      <div class="flex flex-col gap-2">
        <label class="text-white/60 text-sm ml-1">Author</label>
        <input name="author" type="text" required class="bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" placeholder="Julio Cortázar" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-2">
          <label class="text-white/60 text-sm ml-1">Pages</label>
          <input name="pages" type="number" class="bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-white/60 text-sm ml-1">Status</label>
          <select name="status" class="bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
            <option value="plan to read" class="bg-gray-900">Plan to read</option>
            <option value="reading" class="bg-gray-900">Reading</option>
            <option value="completed" class="bg-gray-900">Completed</option>
            
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label class="text-white/60 text-sm ml-1">Cover URL (Image)</label>
        <input name="img" type="url" class="bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition" placeholder="https://..." />
      </div>

      <button type="submit" class="mt-4 bg-white text-black font-bold py-4 rounded-xl hover:bg-white/80 transition shadow-lg cursor-pointer hover:shadow-xl">
        Save Book
      </button>

    </form>
  </section>
</Layout>