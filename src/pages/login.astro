---
import LayoutPublic from "../layouts/LayoutPublic.astro";
import "@fontsource/dm-serif-text";
---

<LayoutPublic title="Entrar | Hiram Books">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div
      class="w-full h-[600px] bg-white rounded-[2.5rem] overflow-hidden flex shadow-2xl relative z-10"
    >
      <div class="w-1/2 relative bg-black hidden lg:block">
        <div class="absolute inset-0">
          <img
            src="books.jpg"
            alt="background w books lol"
            class="w-full h-full object-cover opacity-40"
          />
          <div
            class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/60"
          >
          </div>
        </div>

        <div
          class="relative z-10 p-10 flex flex-col justify-between h-full text-white"
        >
          <div class="flex items-center gap-4">
            <span class="text-[10px] font-medium tracking-widest uppercase"
            ></span>
          </div>

          <div>
            <h1 class="text-5xl font-serif leading-tight mb-4">
              Start tracking, <br />
              start reading
            </h1>
            <p class="text-white/80 text-md leading-relaxed max-w-xs">
              Add books to your personal bookshelf and discover a new
              way to keep track of your favorite books
            </p>
          </div>
        </div>
      </div>

      <!-- Right Side - Login Form -->
      <div
        class="w-full lg:w-1/2 bg-white p-8 flex flex-col justify-center items-center relative"
      >
        <div class="w-full max-w-xs">
          <div class="text-center mb-8">
            <div class="flex justify-center mb-6">
              <div class="flex items-center bg-black p-4 rounded-3xl">
                  <img src="logo.png" alt="hibookshelf logo" class="w-14 h-auto" />
              </div>
            </div>

            <h2 class="text-3xl font-serif text-gray-900 mb-2">
              Sign in to your account
            </h2>
            <p class="text-gray-500 text-xs">
              Right now we just have these authentication methods
            </p>
          </div>

          <div class="space-y-4">
            <!-- GitHub Button -->
            <a
              href="/api/auth/signin"
              class="flex items-center justify-center gap-3 w-full bg-black text-white h-12 rounded-xl text-sm font-medium hover:bg-gray-900 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 duration-200"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
              Sign In with GitHub
            </a>

            <div class="relative flex py-2 items-center">
              <div class="flex-grow border-t border-gray-200"></div>
              <span class="flex-shrink-0 mx-4 text-gray-400 text-[10px]"
                >Or maybe use</span
              >
              <div class="flex-grow border-t border-gray-200"></div>
            </div>

            <button
              class="flex items-center justify-center gap-3 w-full bg-white border border-gray-200 text-gray-700 h-12 rounded-xl text-sm font-medium hover:bg-gray-50 transition-colors"
              disabled
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  fill="#4285F4"></path>
                <path
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  fill="#34A853"></path>
                <path
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  fill="#FBBC05"></path>
                <path
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  fill="#EA4335"></path>
              </svg>
              Sign In with Google
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</LayoutPublic>
